# Base de Keycloak (jamais exposée hors du serveur).
POSTGRES_PASSWORD=

# Compte d'administration d'amorçage — TEMPORAIRE (README, étape 6).
KC_BOOTSTRAP_ADMIN_USERNAME=amorcage
KC_BOOTSTRAP_ADMIN_PASSWORD=
