{
  "realm": "edilumen",
  "displayName": "Edilumen — connexion unique de la gamme",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "supabase-lab",
      "name": "Supabase Auth du lab (joue Socle / Clara / Iris)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "supabase-secret-lab",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://127.0.0.1:54321/auth/v1/callback", "http://localhost:54321/auth/v1/callback"],
      "webOrigins": ["+"]
    }
  ],
  "identityProviders": [
    {
      "alias": "mairie-demo",
      "displayName": "Compte de la Mairie de démonstration",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "issuer": "http://${LAB_HOST}:8180/realms/mairie-demo",
        "authorizationUrl": "http://${LAB_HOST}:8180/realms/mairie-demo/protocol/openid-connect/auth",
        "tokenUrl": "http://${LAB_HOST}:8180/realms/mairie-demo/protocol/openid-connect/token",
        "userInfoUrl": "http://${LAB_HOST}:8180/realms/mairie-demo/protocol/openid-connect/userinfo",
        "jwksUrl": "http://${LAB_HOST}:8180/realms/mairie-demo/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "edilumen-broker",
        "clientSecret": "broker-secret-lab",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT"
      }
    }
  ],
  "users": [
    {
      "username": "agent.local",
      "email": "agent.local@edilumen.test",
      "emailVerified": true,
      "firstName": "Agent",
      "lastName": "Sans annuaire",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Edilumen!2026", "temporary": false }]
    }
  ]
}
